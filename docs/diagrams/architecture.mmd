flowchart TD
    subgraph Client["Browser"]
        UI["One-page Next.js interface<br/>paste or upload SQL, get a rating,<br/>suggestions and analysis"]
    end
    subgraph Server["Next.js server (route handlers)"]
        API["/api/analyze  /api/state<br/>/api/runs  /api/run/:id"]
        GUARD["SQL guard<br/>one SELECT or WITH only,<br/>comments and hints removed"]
        PARSE["Plan parser<br/>reads EXPLAIN ANALYZE text,<br/>separates measured from estimated"]
    end
    subgraph MySQL["MySQL 8.0 server (service MySQL80, port 3306)"]
        RUNNER["Account qa_runner<br/>SELECT on 4 shop tables only<br/>READ ONLY transaction, 5 s limit"]
        APP["Account qa_app<br/>read and write on project tables,<br/>EXECUTE stored routines"]
        subgraph DB["Database shop_query_analyzer"]
            SHOP["Shop data<br/>customers, products,<br/>orders, order_items"]
            ANA["Analyzer data<br/>saved_queries, query_executions,<br/>query_plans, execution_table_access,<br/>recommendations"]
            LOGIC["Stored logic<br/>functions, procedures,<br/>2 triggers, 1 view"]
        end
    end
    MONGO["MongoDB 8.2<br/>database shop_query_analyzer_docs<br/>collection plans: one document per run"]
    TERM["MySQL terminal and mongosh<br/>same data as the page"]
    UI -->|"JSON"| API
    API --> GUARD
    GUARD -->|"validated SQL"| RUNNER
    RUNNER -->|"EXPLAIN ANALYZE"| SHOP
    RUNNER -->|"plan text"| PARSE
    PARSE -->|"metrics"| APP
    APP -->|"CALL sp_save_query, sp_log_execution<br/>INSERT table accesses"| ANA
    ANA --- LOGIC
    PARSE -->|"same run as a document"| MONGO
    TERM --- DB
    TERM --- MONGO
    classDef ui fill:#dbe7ff,stroke:#1d5fd1,color:#102a6b
    classDef srv fill:#e4f5ea,stroke:#0b6b4d,color:#0d4a23
    classDef db fill:#fdf1d8,stroke:#8a5a00,color:#5a3b05
    classDef nosql fill:#e6f2e6,stroke:#2e7d32,color:#1b4d1e
    classDef term fill:#eee,stroke:#555,color:#222
    class UI ui
    class API,GUARD,PARSE srv
    class RUNNER,APP,SHOP,ANA,LOGIC db
    class MONGO nosql
    class TERM term
