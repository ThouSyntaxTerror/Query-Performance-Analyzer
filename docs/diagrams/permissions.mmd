flowchart LR
    subgraph Accounts["MySQL accounts"]
        U1["qa_app"]
        U2["qa_viewer"]
        U3["qa_runner<br/>max 5 connections"]
    end
    subgraph Roles["Roles (default role of each account)"]
        R1["qa_app_role"]
        R2["qa_viewer_role"]
        R3["qa_runner_role"]
    end
    subgraph Rights["Privileges on shop_query_analyzer"]
        P1["SELECT, INSERT, UPDATE, DELETE<br/>on all tables<br/>EXECUTE on routines"]
        P2["SELECT on all tables and views<br/>EXECUTE fn_cosine_similarity only<br/>no INSERT, UPDATE, DELETE"]
        P3["SELECT on customers, products,<br/>orders, order_items only<br/>no analyzer tables, no writes,<br/>no DDL, no routines"]
    end
    U1 --> R1 --> P1
    U2 --> R2 --> P2
    U3 --> R3 --> P3
    W1["Used by the web app<br/>to store runs and plans"] -.-> U1
    W2["Used in the terminal demo<br/>to show a read-only user"] -.-> U2
    W3["Used by the web app to execute<br/>the user's SQL safely"] -.-> U3
